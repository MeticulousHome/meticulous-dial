{
  "dataSources": [
    {
      "id": "clock",
      "refreshMs": 1000,
      "source": "time"
    },
    {
      "id": "network",
      "refreshMs": 60000,
      "source": "wifi"
    }
  ],
  "documentType": "meticulous-idle-screen",
  "id": "metCat",
  "layers": [
    {
      "color": {
        "token": "colors.status"
      },
      "font": {
        "align": "center",
        "family": {
          "token": "fonts.digits"
        },
        "size": 20,
        "weight": 500
      },
      "id": "wifiStatus",
      "maxLines": 1,
      "text": {
        "binding": {
          "fallback": "Not connected",
          "formatter": {
            "falseLabel": "Not connected",
            "trueLabel": "Ready",
            "type": "boolean"
          },
          "path": "connected",
          "source": "wifi"
        }
      },
      "transform": {
        "height": 32,
        "width": 300,
        "x": 90,
        "y": 25
      },
      "type": "text",
      "verticalAlign": "middle",
      "wrap": "none"
    },
    {
      "color": {
        "token": "colors.digits"
      },
      "font": {
        "align": "center",
        "family": {
          "token": "fonts.digits"
        },
        "size": {
          "token": "numbers.digitSize"
        },
        "tabularNumbers": true,
        "weight": 300
      },
      "hourMode": "locale",
      "id": "time",
      "separatorBlink": false,
      "template": "HH:mm",
      "transform": {
        "height": 110,
        "width": 400,
        "x": 40,
        "y": 105
      },
      "type": "digitalTime"
    },
    {
      "asset": "metcatAnimation",
      "autoplay": false,
      "id": "metcat",
      "loop": false,
      "segments": [
        {
          "from": 0,
          "loop": false,
          "name": "intro",
          "playOnce": true,
          "to": 120
        },
        {
          "from": 120,
          "loop": true,
          "name": "loop",
          "playOnce": false,
          "to": 313
        }
      ],
      "speed": 1,
      "transform": {
        "height": 180,
        "width": 320,
        "x": 80,
        "y": 190
      },
      "type": "lottie"
    }
  ],
  "name": "Digital Cat Clock",
  "runtime": {
    "brightness": {
      "brightDurationMs": 5000,
      "brightValue": 0.33,
      "cycleAfterMs": 600000,
      "dimDurationMs": 55000,
      "dimValue": 0.03,
      "onEnter": 0.33,
      "onExit": 1
    },
    "burnInProtection": {
      "distance": 0.5,
      "durationMs": 3600000,
      "enabled": true,
      "mode": "rotate"
    }
  },
  "runtimeApi": 1,
  "schemaVersion": 2,
  "tokens": {
    "colors": {
      "background": "#000000",
      "digits": "#DDDDDD",
      "status": "#606060"
    },
    "fonts": {
      "digits": "ABC Diatype"
    },
    "numbers": {
      "digitSize": 84
    }
  },
  "viewport": {
    "background": {
      "token": "colors.background"
    },
    "height": 480,
    "overflow": "hidden",
    "shape": "circle",
    "width": 480
  }
}
