{
  "dataSources": [
    {
      "id": "clock",
      "refreshMs": 1000,
      "source": "time"
    },
    {
      "id": "network",
      "refreshMs": 60000,
      "source": "wifi"
    }
  ],
  "documentType": "meticulous-idle-screen",
  "id": "digital",
  "layers": [
    {
      "color": {
        "token": "colors.status"
      },
      "font": {
        "align": "center",
        "family": {
          "token": "fonts.digits"
        },
        "size": 20,
        "weight": 500
      },
      "id": "wifiStatus",
      "maxLines": 1,
      "text": {
        "binding": {
          "fallback": "Not connected",
          "formatter": {
            "falseLabel": "Not connected",
            "trueLabel": "Ready",
            "type": "boolean"
          },
          "path": "connected",
          "source": "wifi"
        }
      },
      "transform": {
        "height": 32,
        "width": 300,
        "x": 90,
        "y": 25
      },
      "type": "text",
      "verticalAlign": "middle",
      "wrap": "none"
    },
    {
      "color": {
        "token": "colors.digits"
      },
      "font": {
        "align": "center",
        "family": {
          "token": "fonts.digits"
        },
        "lineHeight": 0.9,
        "size": {
          "token": "numbers.digitSize"
        },
        "tabularNumbers": true,
        "weight": 400
      },
      "hourMode": "locale",
      "id": "time",
      "middayColor": {
        "token": "colors.status"
      },
      "middayFont": {
        "align": "center",
        "family": {
          "token": "fonts.digits"
        },
        "size": 55,
        "weight": 500
      },
      "separatorBlink": false,
      "template": "stackedHM",
      "transform": {
        "height": 280,
        "width": 420,
        "x": 30,
        "y": 120
      },
      "type": "digitalTime"
    }
  ],
  "name": "Digital Clock",
  "runtime": {
    "brightness": {
      "brightDurationMs": 5000,
      "brightValue": 0.33,
      "cycleAfterMs": 600000,
      "dimDurationMs": 55000,
      "dimValue": 0.03,
      "onEnter": 0.33,
      "onExit": 1
    },
    "burnInProtection": {
      "distance": 0.5,
      "durationMs": 3600000,
      "enabled": true,
      "mode": "rotate"
    }
  },
  "runtimeApi": 1,
  "schemaVersion": 2,
  "tokens": {
    "colors": {
      "background": "#000000",
      "digits": "#DDDDDD",
      "status": "#606060"
    },
    "fonts": {
      "digits": "ABC Diatype"
    },
    "numbers": {
      "digitSize": 110
    }
  },
  "viewport": {
    "background": {
      "token": "colors.background"
    },
    "height": 480,
    "overflow": "hidden",
    "shape": "circle",
    "width": 480
  }
}
