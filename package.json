{
  "name": "meticulous-dial-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "docker:arm64": "docker build . -t rust_native_compile/arm64 -f Dockerfile.arm64",
    "docker:arm64-trixie": "docker build . -t rust_cross_compile_trixie/arm64 -f Dockerfile.arm64-trixie",
    "package:arm64": "docker run --platform linux/arm64/v8 --rm -ti -v `pwd`:/app rust_native_compile/arm64",
    "package:arm64-trixie": "docker run --rm -ti -v `pwd`:/app rust_cross_compile_trixie/arm64"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@tauri-apps/cli": "^2"
  }
}
