{
  "name": "meticulous-dial",
  "productName": "meticulous-dial",
  "version": "1.101.2",
  "description": "My Electron application description",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "commit": "git-cz",
    "format": "prettier --config .prettierrc \"{src/**/,.github/**/,}*.{tsx,ts,md,js,css,html,json,yml}\" --write",
    "format:check": "prettier --config .prettierrc \"{src/**/,.github/**/,}*.{tsx,ts,md,js,css,html,json,yml}\" --check",
    "types": "tsc --noEmit",
    "prepare": "husky",
    "lint": "eslint .",
    "dev": "VITE_SERVER_URL=\"${SERVER_URL}\" vite",
    "build": "tsc && vite build",
    "tauri": "VITE_SERVER_URL=\"${SERVER_URL}\" tauri",
    "docker:arm64-qemu": "docker build . -t rust_native_compile/arm64 -f Dockerfile.arm64-qemu",
    "docker:arm64-cross": "docker build . -t rust_cross_compile_trixie/arm64 -f Dockerfile.arm64-cross",
    "package:arm64-qemu": "docker run --platform linux/arm64/v8 --rm -v `pwd`:/app rust_native_compile/arm64",
    "package:arm64-cross": "docker run --rm -v `pwd`:/app rust_cross_compile_trixie/arm64"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MeticulousHome/meticulous-dial"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": "prettier --config .prettierrc \"src/**/*.{js,tsx,ts}\" --check --ignore-unknown"
  },
  "keywords": [],
  "author": {
    "name": "salatielosorno",
    "email": "salatiel.linares@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "@eslint/js": "^9.10.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@tauri-apps/cli": "^2.9.4",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-react": "^5.1.1",
    "commitizen": "^4.3.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-import-resolver-webpack": "^0.13.9",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-react": "^7.36.1",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "globals": "^16.5.0",
    "husky": "^9.1.6",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "less-plugin-unique-directives": "^0.1.0",
    "lint-staged": "^16.2.7",
    "node-loader": "^2.0.0",
    "prettier": "^3.3.3",
    "schema-utils": "^4.2.0",
    "semantic-release": "^25.0.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.6.0",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@meticulous-home/espresso-api": "^0.10.8",
    "@meticulous-home/espresso-profile": "^0.4.2",
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/react-query": "^5.56.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "axios": "^1.7.7",
    "classnames": "^2.5.1",
    "fast-deep-equal": "^3.1.3",
    "fast-equals": "^5.2.2",
    "framer-motion": "^12.23.12",
    "lottie-web": "^5.12.2",
    "nanoevents": "^9.0.0",
    "react": "^18.3.1",
    "react-animated-counter": "^1.7.9",
    "react-dom": "^18.3.1",
    "react-freeze": "^1.0.4",
    "react-qr-code": "^2.0.18",
    "react-redux": "^9.1.2",
    "react-transition-group": "^4.4.5",
    "socket.io-client": "^4.7.5",
    "styled-components": "^6.1.13",
    "swiper": "^12.0.3",
    "uuid": "^13.0.0"
  }
}
