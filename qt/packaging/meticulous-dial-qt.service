[Unit]
Description=Meticulous Dial (Qt Quick, straight on DRM/KMS)
After=network.target meticulous-backend.service systemd-user-sessions.service plymouth-quit-wait.service
# It must be the DRM master: never together with Weston and the WebKit Dial (dial-switch web goes back).
Conflicts=weston.service meticulous-dial.service
OnFailure=crash-reporter@.service

[Service]
ExecStart=/usr/bin/meticulous-dial-qt-launch
Restart=always
RestartSec=1
User=root
MemoryMax=1000M
Slice=meticulous.slice
Environment="XDG_RUNTIME_DIR=/run/user/0"

[Install]
WantedBy=multi-user.target
