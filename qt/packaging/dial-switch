#!/bin/sh
# Switches the machine's display between the Qt Dial and the stock WebKit Dial, now and at boot:
#   dial-switch qt     meticulous-dial.service runs the Qt Dial (drop-in qt.conf), Weston off
#   dial-switch web    back to Weston and the WebKit Dial (the stock image's setup)
#   dial-switch status which one is configured and what runs
# The Qt Dial keeps the unit name meticulous-dial.service, so the nightly meticulous-restart, the watcher
# and crash-reporter keep working with it.
set -e
dropin_dir=/etc/systemd/system/meticulous-dial.service.d
dropin=$dropin_dir/qt.conf
template=/usr/share/meticulous-dial-qt/meticulous-dial-qt.conf
case "${1:-status}" in
qt)
    # An earlier package ran the Qt Dial as its own unit.
    systemctl disable --now meticulous-dial-qt.service 2>/dev/null || true
    rm -f /etc/systemd/system/multi-user.target.wants/meticulous-dial-qt.service
    mkdir -p "$dropin_dir"
    cp "$template" "$dropin"
    systemctl daemon-reload
    systemctl disable --now weston.service
    systemctl enable meticulous-dial.service
    systemctl restart meticulous-dial.service
    ;;
web)
    systemctl disable --now meticulous-dial-qt.service 2>/dev/null || true
    rm -f /etc/systemd/system/multi-user.target.wants/meticulous-dial-qt.service
    rm -f "$dropin"
    rmdir "$dropin_dir" 2>/dev/null || true
    systemctl daemon-reload
    systemctl stop meticulous-dial.service
    systemctl enable weston.service meticulous-dial.service
    systemctl start weston.service
    sleep 2
    systemctl start meticulous-dial.service
    ;;
status)
    if [ -f "$dropin" ]; then echo "configured: qt (meticulous-dial.service runs the Qt Dial)"; else echo "configured: web"; fi
    for unit in meticulous-dial.service weston.service; do
        printf '%-28s %-9s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null)" "$(systemctl is-enabled "$unit" 2>/dev/null)"
    done
    printf '%-28s %s\n' "running" "$(readlink /proc/$(systemctl show -p MainPID --value meticulous-dial.service)/exe 2>/dev/null || echo -)"
    ;;
*)
    echo "usage: dial-switch qt | web | status" >&2
    exit 2
    ;;
esac
