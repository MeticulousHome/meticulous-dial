#!/bin/sh
# Switches the machine's display between the Qt Dial and the stock WebKit Dial, now and at boot:
#   dial-switch qt     meticulous-dial.service runs the Qt Dial (unit in /etc/systemd/system), Weston off
#   dial-switch web    back to Weston and the WebKit Dial (the stock image's setup)
#   dial-switch status which one is configured and what runs
# The Qt Dial keeps the unit name meticulous-dial.service, so the nightly meticulous-restart, the watcher
# and crash-reporter keep working with it.
set -e
unit=/etc/systemd/system/meticulous-dial.service
template=/usr/share/meticulous-dial-qt/meticulous-dial.service
cleanup_old() {
    # Earlier packages ran the Qt Dial as its own unit, then through a drop-in.
    systemctl disable --now meticulous-dial-qt.service 2>/dev/null || true
    rm -f /etc/systemd/system/multi-user.target.wants/meticulous-dial-qt.service
    rm -f /etc/systemd/system/meticulous-dial.service.d/qt.conf
    rmdir /etc/systemd/system/meticulous-dial.service.d 2>/dev/null || true
}
case "${1:-status}" in
qt)
    cleanup_old
    systemctl stop meticulous-dial.service weston.service
    cp "$template" "$unit"
    systemctl daemon-reload
    systemctl disable weston.service
    systemctl reenable meticulous-dial.service
    systemctl start meticulous-dial.service
    ;;
web)
    cleanup_old
    systemctl stop meticulous-dial.service
    rm -f "$unit"
    systemctl daemon-reload
    systemctl reenable weston.service meticulous-dial.service
    systemctl start weston.service
    sleep 2
    systemctl start meticulous-dial.service
    ;;
status)
    if [ -f "$unit" ]; then echo "configured: qt (meticulous-dial.service runs the Qt Dial)"; else echo "configured: web"; fi
    for u in meticulous-dial.service weston.service; do
        printf '%-28s %-9s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null)" "$(systemctl is-enabled "$u" 2>/dev/null)"
    done
    printf '%-28s %s\n' "running" "$(readlink /proc/$(systemctl show -p MainPID --value meticulous-dial.service)/exe 2>/dev/null || echo -)"
    ;;
*)
    echo "usage: dial-switch qt | web | status" >&2
    exit 2
    ;;
esac
